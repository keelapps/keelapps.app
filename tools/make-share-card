#!/usr/bin/env python3
"""Regenerate the site's default share card, assets/banner.png, from the mark.

Every page without its own og:image points at this file — the home page, each
app's docs and privacy pages, the security page. It was drawn by hand for the
first commit, and it ended with the line "recur · accesslens · evergreen ·
digest": four apps, when nine were live by the time anyone noticed. A list of
products is exactly the kind of text an image cannot keep current, so this
card carries none. Its last line names what keelapps makes and where to find
it, which stays true however many apps there are.

The layout is the original card's, measured off it: the plate split at the
mark's waterline, sky above and navy below; the mark on the left at the same
size; the wordmark and the line to its right; the two station marks in the
corners. The mark's paths are the masthead SVG from `index.html` and the
colours are `assets/css/root.css`, as in `tools/make-youtube-banner`.

    tools/make-share-card          # rewrite assets/banner.png

Rendering goes through headless Chrome, with Outfit and Geist Mono fetched at
run time (this site ships no font files), so it needs a network.
"""
import base64
import pathlib
import subprocess
import sys
import tempfile
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "assets" / "banner.png"

FONT_URLS = {
    "Outfit": "https://fonts.gstatic.com/s/outfit/v15/QGYvz_MVcBeNP4NJtEtqUYLknw.woff2",
    "Geist Mono": "https://fonts.gstatic.com/s/geistmono/v6/or3nQ6H-1_WfwkMZI_qYFrcdmhHkjko.woff2",
}

CHROME_CANDIDATES = [
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "/Applications/Chromium.app/Contents/MacOS/Chromium",
    "/usr/bin/google-chrome",
    "/usr/bin/chromium",
]

# --- Canvas: the size every platform's large summary card expects ---------
W, H = 1280, 640

# --- The palette, from root.css -------------------------------------------
NAVY, CREAM, CORAL = "#0F2536", "#F4EFE6", "#E8664A"
SKY = "#132C3F"                    # the original card's water above the line

# --- The mark, viewBox "176 360 672 396" from the masthead ----------------
VB_X, VB_Y = 176, 360
S = 0.494                          # 325px across the stubs, as the original
WATERLINE_Y = 260                  # canvas y of the mark's own waterline
MARK_X0 = 177.5                    # canvas x of the viewBox's left edge
MARK_Y0 = WATERLINE_Y - (392 - VB_Y) * S

# --- Type -----------------------------------------------------------------
TEXT_X = 604
WORD_SIZE, WORD_BASE = 102, 340
TAG_SIZE, TAG_BASE = 27, 404
FOOT_SIZE, FOOT_BASE = 16, 472
MARGIN_SIZE, MARGIN_BASE = 15, 249

WORDMARK = "keelapps"
TAGLINE = "steady tools, built below the waterline"
FOOTER = "apps for atlassian cloud &#183; keelapps.app"


def fetch_fonts():
    faces = {}
    for name, url in FONT_URLS.items():
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 Chrome/131"})
            with urllib.request.urlopen(req, timeout=20) as r:
                faces[name] = base64.b64encode(r.read()).decode()
        except Exception as exc:
            sys.exit(f"could not fetch {name} ({exc}); rendering would fall back to a "
                     f"system face and the type would be wrong")
    return faces


def find_chrome():
    for path in CHROME_CANDIDATES:
        if pathlib.Path(path).exists():
            return path
    sys.exit("no Chrome or Chromium found")


def build_svg():
    return f'''<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">
  <rect width="{W}" height="{WATERLINE_Y}" fill="{SKY}"/>
  <rect y="{WATERLINE_Y}" width="{W}" height="{H - WATERLINE_Y}" fill="{NAVY}"/>

  <g transform="translate({MARK_X0 - VB_X * S:.3f} {MARK_Y0 - VB_Y * S:.3f}) scale({S:.6f})">
    <g fill="none" stroke="{CREAM}" stroke-width="26" stroke-linecap="round">
      <path d="M 196 392 H 304"/>
      <path d="M 720 392 H 828"/>
      <path d="M 352 392 C 360 584, 664 584, 672 392"/>
      <path d="M 512 552 V 648"/>
    </g>
    <circle cx="512" cy="708" r="30" fill="{CORAL}"/>
  </g>

  <text x="66" y="{MARGIN_BASE}" fill="{CREAM}" fill-opacity="0.46"
        font-family="Geist Mono" font-size="{MARGIN_SIZE}">st.00</text>
  <text x="{W - 74}" y="{MARGIN_BASE}" text-anchor="end" fill="{CREAM}" fill-opacity="0.46"
        font-family="Geist Mono" font-size="{MARGIN_SIZE}">wl +0</text>

  <text x="{TEXT_X}" y="{WORD_BASE}" fill="{CREAM}"
        font-family="Outfit" font-size="{WORD_SIZE}" font-weight="700">{WORDMARK}</text>
  <text x="{TEXT_X}" y="{TAG_BASE}" fill="{CREAM}" fill-opacity="0.80"
        font-family="Outfit" font-size="{TAG_SIZE}" font-weight="400"
        letter-spacing="0.6">{TAGLINE}</text>
  <text x="{TEXT_X}" y="{FOOT_BASE}" fill="{CREAM}" fill-opacity="0.46"
        font-family="Geist Mono" font-size="{FOOT_SIZE}"
        letter-spacing="{0.04 * FOOT_SIZE:.2f}">{FOOTER}</text>
</svg>'''


def main():
    faces = fetch_fonts()
    chrome = find_chrome()
    at_fonts = "".join(
        f'@font-face {{ font-family:"{name}"; font-style:normal; font-weight:100 900;'
        f' src:url(data:font/woff2;base64,{b64}) format("woff2"); }}'
        for name, b64 in faces.items())
    html = (f'<!doctype html><html><head><meta charset="utf-8"><style>{at_fonts}'
            f'html,body {{ margin:0; padding:0; background:{NAVY}; }} svg {{ display:block; }}'
            f'</style></head><body>{build_svg()}</body></html>')

    with tempfile.TemporaryDirectory() as tmp:
        page = pathlib.Path(tmp) / "card.html"
        page.write_text(html)
        subprocess.run([chrome, "--headless", "--disable-gpu", "--hide-scrollbars",
                        "--force-device-scale-factor=1", "--virtual-time-budget=4000",
                        f"--window-size={W},{H}", f"--screenshot={OUT}", f"file://{page}"],
                       capture_output=True, check=True)
    print(f"{OUT.relative_to(ROOT)}  {W}x{H}  {OUT.stat().st_size / 1024:.0f} KB")


if __name__ == "__main__":
    main()
