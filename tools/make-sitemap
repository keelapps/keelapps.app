#!/usr/bin/env python3
"""Regenerate sitemap.xml from the pages that exist.

There is no build step, so nothing keeps a sitemap honest except running this.
Every `index.html` in the tree is a page; its URL is its directory, and its
`lastmod` is the date of the last commit that touched it — a page edited but
not yet committed gets today's date, so run this last, in the same commit as
the edit.

    tools/make-sitemap            # rewrite sitemap.xml
    tools/make-sitemap --check    # exit non-zero if a page is missing from it

`--check` compares URLs only. Dates drift with every commit and are not worth
failing on; a page nobody listed is.
"""

import re
import subprocess
import sys
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ORIGIN = "https://keelapps.app"
SKIP = {".git", ".gstack", ".claude", "assets", "tools"}


def pages():
    found = []
    for path in ROOT.rglob("index.html"):
        rel = path.relative_to(ROOT)
        if rel.parts[0] in SKIP:
            continue
        found.append(rel)
    # Home first, then each app's product page ahead of its documents.
    return sorted(found, key=lambda rel: (len(rel.parts), str(rel)))


def url(rel):
    parent = rel.parent.as_posix()
    return f"{ORIGIN}/" if parent == "." else f"{ORIGIN}/{parent}/"


def lastmod(rel):
    dirty = subprocess.run(
        ["git", "status", "--porcelain", "--", str(rel)],
        cwd=ROOT, capture_output=True, text=True, check=True,
    ).stdout.strip()
    if dirty:
        return date.today().isoformat()
    committed = subprocess.run(
        ["git", "log", "-1", "--format=%cs", "--", str(rel)],
        cwd=ROOT, capture_output=True, text=True, check=True,
    ).stdout.strip()
    return committed or date.today().isoformat()


def render():
    lines = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">',
    ]
    for rel in pages():
        lines.append(f"  <url><loc>{url(rel)}</loc><lastmod>{lastmod(rel)}</lastmod></url>")
    lines.append("</urlset>")
    return "\n".join(lines) + "\n"


def main(argv):
    target = ROOT / "sitemap.xml"
    if "--check" in argv:
        listed = set(re.findall(r"<loc>(.*?)</loc>", target.read_text())) if target.exists() else set()
        missing = [url(rel) for rel in pages() if url(rel) not in listed]
        for m in missing:
            print(f"not in sitemap.xml: {m}")
        return 1 if missing else 0
    target.write_text(render())
    print(f"{target.name}: {len(pages())} pages")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
